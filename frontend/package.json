{
  "name": "skillgraph-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests *.ts *.json index.html",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests *.ts *.json index.html",
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:auth-stack": "node node_modules/@playwright/test/cli.js test --config playwright.auth-stack.config.ts",
    "test:rbac": "node node_modules/@playwright/test/cli.js test --config playwright.rbac.config.ts",
    "test:live": "node node_modules/@playwright/test/cli.js test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
