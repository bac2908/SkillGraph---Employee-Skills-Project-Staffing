COGNODB_URI=
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Authentication: local defaults work without extra configuration.
# Set true behind HTTPS before exposing the application.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
# Production example (JSON array; exact public frontend origin, no trailing slash):
# AUTH_ALLOWED_ORIGINS=["https://skillgraph.example.com"]
# AUTH_DB_PATH=D:/private-skillgraph-data/auth.sqlite3
